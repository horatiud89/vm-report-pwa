{
  "name": "vm-photo-report",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "functions"
  ],
  "scripts": {
    "test": "vitest run",
    "test:emulators": "firebase emulators:exec --only auth,firestore,storage --project demo-vm-report \"vitest run --config vitest.emulators.config.ts\"",
    "typecheck": "tsc -p shared && tsc -p functions",
    "build": "npm run build -w app && npm run build -w functions"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.34.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
